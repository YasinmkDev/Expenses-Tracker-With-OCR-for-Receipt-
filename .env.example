# Parseur performs image/document OCR and extraction.
EXPO_PUBLIC_PARSEUR_API_KEY=
EXPO_PUBLIC_PARSEUR_MAILBOX_ID=213962

# Gemini organizes OCR.space text into validated receipt/invoice data.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Supabase cloud sync. The app also accepts NEXT_PUBLIC_* names if you use a shared env file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
