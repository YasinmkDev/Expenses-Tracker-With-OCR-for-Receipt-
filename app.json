{
  "expo": {
    "name": "ledger_react_native",
    "slug": "redger-expenses-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appLogo.png",
    "scheme": "ledgerreactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/appLogo.png"
    },
    "android": {
      "package": "com.yasinmk.ledgerexpenses",
      "adaptiveIcon": {
        "backgroundColor": "#0E1321",
        "foregroundImage": "./assets/images/appLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/appLogo.png"
    },
    "splash": {
      "image": "./assets/images/appSplashScreenFullScreenImage.png",
      "resizeMode": "cover",
      "backgroundColor": "#0E1321"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1321",
          "image": "./assets/images/appSplashScreenFullScreenImage.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ledger to access your camera to scan receipts and itemized invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ledger to access your photos to select receipt images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ad6ac8e-db0f-4295-9f1c-6645eb31d6a5"
      }
    },
    "owner": "yasinmk"
  }
}
